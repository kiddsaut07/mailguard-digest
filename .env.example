# Exemple de configuration locale de MailGuard Digest.
# Copier ce fichier en `.env` puis adapter les valeurs.
# `.env` est ignoré par Git : ne jamais versionner de secrets.

# --- Application Flask -------------------------------------------------------
# Obligatoire hors développement. Générer avec :
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Mode débogage : 0 par défaut. Ne jamais activer sur une machine partagée.
FLASK_DEBUG=0

# Interface d'écoute. 127.0.0.1 par défaut : application locale uniquement.
MAILGUARD_HOST=127.0.0.1
MAILGUARD_PORT=5000

# --- Stockage local ----------------------------------------------------------
# Chemin du fichier SQLite de l'historique, relatif à la racine du projet.
MAILGUARD_DATABASE_PATH=data/mailguard.sqlite3

# --- Limites d'import (voir 03_SECURITY_PRIVACY.md) --------------------------
# 10 Mio par fichier compressé, 50 Mio décompressés, 100 membres, 20 rapports.
MAILGUARD_MAX_COMPRESSED_BYTES=10485760
MAILGUARD_MAX_DECOMPRESSED_BYTES=52428800
MAILGUARD_MAX_ARCHIVE_MEMBERS=100
MAILGUARD_MAX_REPORTS_PER_IMPORT=20

# Nombre maximal de `<record>` par rapport XML. Les limites ci-dessus bornent les
# octets, pas l'expansion mémoire : un rapport de 154 000 records tient dans
# 680 Kio compressés mais occupe près d'un gigaoctet une fois analysé. Les
# rapports agrégés légitimes en contiennent quelques centaines à quelques
# milliers ; cette valeur peut être relevée en connaissance de cause.
MAILGUARD_MAX_RECORDS_PER_REPORT=10000

# Taille maximale acceptée par Flask pour une requête HTTP, en octets.
# 12 Mio : un peu au-dessus de la limite fichier pour laisser de la marge aux
# en-têtes multipart, tout en refusant les envois très volumineux.
MAILGUARD_MAX_CONTENT_LENGTH=12582912

# --- Narration IA locale facultative (Ollama) --------------------------------
# Désactivée par défaut : MAILGUARD_AI_ENABLED=0 n'envoie aucune requête réseau.
# Ollama doit être installé et démarré séparément ; le modèle doit déjà être
# présent en local (aucun téléchargement n'est déclenché par l'application).
MAILGUARD_AI_ENABLED=0

# Endpoint local. Seules les adresses de boucle locale sont acceptées sauf si
# MAILGUARD_OLLAMA_ALLOW_REMOTE vaut explicitement 1.
MAILGUARD_OLLAMA_URL=http://127.0.0.1:11434

# Nom du modèle déjà téléchargé localement, par exemple un modèle de petite
# taille adapté à une machine modestement équipée.
MAILGUARD_OLLAMA_MODEL=

# Délai maximal de la requête (connexion et lecture), en secondes.
MAILGUARD_OLLAMA_TIMEOUT_SECONDS=10

# Bornes du prompt envoyé et de la génération reçue.
MAILGUARD_OLLAMA_MAX_INPUT_CHARS=4000
MAILGUARD_OLLAMA_MAX_OUTPUT_TOKENS=300

# Opt-in avancé : autoriser un endpoint Ollama non local. À éviter.
MAILGUARD_OLLAMA_ALLOW_REMOTE=0